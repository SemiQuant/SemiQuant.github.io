---
/**
 * Small mono tag. Renders a link when href is given, otherwise a span.
 * Usage: <TagChip>nanopore</TagChip> or <TagChip href="/publications/?q=tb">TB</TagChip>
 * Wrap several in <ul class="cluster"> or a .cluster div.
 */
interface Props {
  href?: string;
  /** "accent" tints the chip for a single highlighted tag. */
  tone?: 'default' | 'accent';
}

const { href, tone = 'default' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['chip', tone]} href={href}><slot /></Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.375rem;
    padding: 0 var(--s-2);
    border: var(--hair);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  .accent {
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--accent-text);
  }
  /* Linked chips are controls: a 3:1 boundary. Static chips keep the hairline. */
  a.chip:not(.accent) {
    border-color: var(--border-strong);
  }
  a.chip:hover {
    color: var(--text);
    border-color: var(--text);
  }
</style>
