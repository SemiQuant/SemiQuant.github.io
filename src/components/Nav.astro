---
/**
 * Site header: SQ mark, wordmark, section links, theme toggle.
 * Rendered by layouts/Base.astro; pages do not need to include it.
 * Links come from `nav` in src/data/profile.ts. The link whose href prefixes
 * the current path gets aria-current="page". Below 960px the links collapse
 * behind a menu button (with JavaScript off they stay visible as a wrapped row).
 */
import { Image } from 'astro:assets';
import mark from '../assets/brand/sq-512.png';
import { nav, profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';

interface Props {}

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${profile.brand}: home`}>
      <Image src={mark} alt="" width={28} height={28} densities={[1, 2, 3]} loading="eager" />
      <span class="wordmark">{profile.brand}</span>
    </a>

    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
      <span class="bars" aria-hidden="true"><i></i><i></i></span>
      <span>Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle class="nav-toggle" />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: var(--hair);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--s-4);
    min-height: var(--nav-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-right: auto;
    padding-block: var(--s-2);
    color: var(--text);
    text-decoration: none;
  }
  .brand img {
    width: 28px;
    height: 28px;
  }
  .wordmark {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0 var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--nav-h);
    color: var(--muted);
    font-size: var(--fs-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav a:hover {
    color: var(--text);
  }
  .site-nav a[aria-current='page'] {
    color: var(--text);
  }
  .site-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 2px;
    background: var(--accent);
  }
  .menu-btn {
    display: none;
    align-items: center;
    gap: var(--s-2);
    height: 2rem;
    padding: 0 var(--s-3);
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    cursor: pointer;
  }
  .menu-btn:hover {
    border-color: var(--text);
  }
  .bars {
    display: grid;
    gap: 4px;
    width: 14px;
  }
  .bars i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur);
  }
  .menu-btn[aria-expanded='true'] .bars i:first-child {
    transform: translateY(2.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .bars i:last-child {
    transform: translateY(-2.5px) rotate(-45deg);
  }

  @media (max-width: 959.98px) {
    /* No JavaScript: links stay visible as a wrapped row under the brand. */
    .site-nav {
      order: 5;
      flex-basis: 100%;
      border-top: var(--hair);
    }
    .site-nav a {
      min-height: 2.75rem;
    }
    .site-nav a[aria-current='page']::after {
      inset: auto 0 0.5rem 0;
      height: 1px;
    }
    :global(.js) .menu-btn {
      display: inline-flex;
      order: 3;
    }
    :global(.js) .site-nav {
      display: none;
    }
    :global(.js) .site-header[data-open] .site-nav {
      display: block;
    }
    :global(.js) .site-nav ul {
      flex-direction: column;
      padding-block: var(--s-2) var(--s-3);
    }
    :global(.js) .site-nav li + li {
      border-top: var(--hair);
    }
    :global(.js) .site-nav a {
      min-height: 2.75rem;
      font-size: var(--fs-base);
    }
    :global(.js) .site-nav a[aria-current='page'] {
      color: var(--accent-text);
    }
    :global(.js) .site-nav a[aria-current='page']::after {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const btn = header?.querySelector<HTMLButtonElement>('[data-menu-btn]');
  if (header && btn) {
    const set = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => set(!header.hasAttribute('data-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.hasAttribute('data-open')) {
        set(false);
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 960px)').addEventListener('change', () => set(false));
  }
</script>
