---
/**
 * Responsive grid of optimized thumbnails. Clicking one opens a native
 * <dialog> lightbox with previous / next buttons, arrow keys, Esc to close,
 * and focus returned to the thumbnail. Without JavaScript each thumbnail
 * links to the full-size image.
 * Usage (images from a `builds` entry):
 *   <Gallery images={entry.data.images} />
 * Each image needs meaningful alt text; it doubles as the caption.
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  /** Accessible name for the list. */
  label?: string;
}

const { images, label = 'Photos' } = Astro.props;

const items = await Promise.all(
  images.map(async (im) => {
    const full = await getImage({ src: im.src, width: Math.min(im.src.width, 1800) });
    return { ...im, full };
  }),
);
---

{
  items.length > 0 && (
    <div class="gallery" data-gallery>
      <ul aria-label={label}>
        {items.map((im, i) => (
          <li>
            <a href={im.full.src} data-index={i} data-alt={im.alt}>
              <Image src={im.src} alt={im.alt} width={560} height={420} fit="cover" loading="lazy" />
            </a>
          </li>
        ))}
      </ul>

      <dialog class="lightbox" aria-label="Image viewer">
        <div class="lb-bar">
          <span class="lb-count" data-lb-count aria-live="polite" />
          <button type="button" class="lb-btn" data-lb-close>
            Close
          </button>
        </div>
        <div class="lb-stage">
          <img data-lb-img alt="" />
        </div>
        <div class="lb-foot">
          <button type="button" class="lb-btn" data-lb-prev aria-label="Previous image">
            <span aria-hidden="true">&larr;</span> Prev
          </button>
          <p class="lb-cap" data-lb-cap />
          <button type="button" class="lb-btn" data-lb-next aria-label="Next image">
            Next <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
      </dialog>
    </div>
  )
}

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-3);
    }
  }
  @media (min-width: 960px) {
    ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  li a {
    display: block;
    border: var(--hair);
    border-radius: var(--radius);
    background: var(--surface-2);
    overflow: hidden;
    transition: border-color var(--dur);
  }
  li a:hover {
    border-color: var(--border-strong);
  }
  li :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity var(--dur);
  }
  li a:hover :global(img) {
    opacity: 0.88;
  }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--scrim);
    color: #e6e8eb;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }
  .lightbox::backdrop {
    background: var(--scrim);
  }
  .lb-bar,
  .lb-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--gutter);
  }
  .lb-count {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--track-caps);
    font-variant-numeric: tabular-nums;
    color: #9aa3af;
  }
  .lb-stage {
    position: relative;
    min-height: 0;
    margin-inline: var(--gutter);
  }
  .lb-stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  .lb-cap {
    flex: 1;
    min-width: 0;
    font-size: var(--fs-sm);
    line-height: 1.4;
    text-align: center;
    color: #c9ced6;
  }
  @media (max-width: 639.98px) {
    .lb-foot {
      flex-wrap: wrap;
    }
    .lb-cap {
      order: -1;
      flex-basis: 100%;
      text-align: left;
    }
  }
  .lb-btn {
    flex: none;
    height: 2.25rem;
    padding: 0 var(--s-3);
    background: transparent;
    color: #e6e8eb;
    border: 1px solid #647082;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    cursor: pointer;
  }
  .lb-btn:hover {
    border-color: #e6e8eb;
  }
  .lb-btn:focus-visible {
    outline-color: #f7941d;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('dialog');
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('a[data-index]'));
    const img = root.querySelector<HTMLImageElement>('[data-lb-img]');
    const cap = root.querySelector<HTMLElement>('[data-lb-cap]');
    const count = root.querySelector<HTMLElement>('[data-lb-count]');
    if (!dialog || !img || typeof dialog.showModal !== 'function' || links.length === 0) return;

    let current = 0;
    let opener: HTMLElement | null = null;
    const single = links.length < 2;
    root.querySelectorAll<HTMLElement>('[data-lb-prev], [data-lb-next]').forEach((b) => (b.hidden = single));

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current];
      img.src = link.href;
      img.alt = link.dataset.alt ?? '';
      if (cap) cap.textContent = link.dataset.alt ?? '';
      if (count) count.textContent = `${current + 1} / ${links.length}`;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      }),
    );

    root.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    root.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('keydown', (e) => {
      if (single) return;
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // A click on the bars' empty space closes; the image and buttons do not.
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.classList.contains('lb-bar') || t.classList.contains('lb-foot')) dialog.close();
    });
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      opener?.focus();
      opener = null;
    });
  });
</script>
