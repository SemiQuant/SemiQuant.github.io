---
/**
 * Channel-style section label: "01 / RESEARCH" in mono caps, followed by a
 * hairline rule with tick marks. It is the section heading itself.
 * Usage: <SectionLabel index="01" label="Research" />
 * The optional "aside" slot sits at the right end (a count, a "view all" link).
 */
interface Props {
  /** Channel number, e.g. "01" or 1. */
  index?: string | number;
  label: string;
  /** Heading level. Default h2. */
  as?: 'h2' | 'h3';
  id?: string;
}

const { index, label, as: Tag = 'h2', id } = Astro.props;
const idx = index === undefined ? undefined : String(index).padStart(2, '0');
---

<div class="section-label">
  <Tag class="text" id={id}>
    {idx && <span class="idx">{idx}</span>}
    {idx && <span class="sep" aria-hidden="true">/</span>}
    <span>{label}</span>
  </Tag>
  <span class="ticks" aria-hidden="true"></span>
  {Astro.slots.has('aside') && <div class="aside"><slot name="aside" /></div>}
</div>

<style>
  .section-label {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--s-2) var(--s-3);
    margin-bottom: var(--s-5);
  }
  .text {
    display: inline-flex;
    gap: 0.6em;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    min-width: 0;
  }
  .text > span {
    flex: none;
  }
  .text > span:last-child {
    flex: 0 1 auto;
  }
  .idx {
    color: var(--accent-text);
  }
  .sep {
    color: var(--faint);
  }
  /* Hairline with minor ticks every 8px and a taller tick every 40px. */
  .ticks {
    flex: 1;
    min-width: 1rem;
    height: 7px;
    background:
      linear-gradient(var(--border), var(--border)) left bottom / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 40px) left bottom / 100% 7px no-repeat,
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 8px) left bottom / 100% 4px no-repeat;
  }
  .aside {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Phones: a long label keeps the first row; the aside drops below it. */
  @media (max-width: 419.98px) {
    .aside {
      flex-basis: 100%;
    }
  }
  .aside :global(a) {
    text-decoration: none;
  }
  .aside :global(a:hover) {
    text-decoration: underline;
  }
</style>
