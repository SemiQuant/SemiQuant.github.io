---
/**
 * Home hero graphic: a qPCR amplification plot drawn as inline SVG.
 * A ten-fold dilution series (five curves about 3.3 cycles apart) plus a flat
 * no-template control, on a log fluorescence axis with a dashed threshold.
 * One curve is drawn in the accent color with its Ct marked.
 * Decorative: aria-hidden, no data behind it. The curves draw in once and
 * stay still under prefers-reduced-motion.
 * Usage: <QpcrCurve />   (fills its container's width; aspect 16:10)
 */
interface Props {
  class?: string;
  /** Show axis numbers and labels. Default true. */
  labels?: boolean;
}

const { class: className, labels = true } = Astro.props;

const W = 640;
const H = 400;
const M = { l: 44, r: 12, t: 14, b: 30 };
const PW = W - M.l - M.r;
const PH = H - M.t - M.b;
const CYCLES = 40;
const LOG_MIN = -3;
const LOG_MAX = 1;
const THRESHOLD = 0.1;
const K = 0.66; // per-cycle growth rate in the exponential phase (ln 2 would be perfect doubling)

const r1 = (n: number) => Math.round(n * 10) / 10;
const x = (cycle: number) => M.l + (cycle / CYCLES) * PW;
const y = (v: number) => M.t + ((LOG_MAX - Math.log10(v)) / (LOG_MAX - LOG_MIN)) * PH;

/** Small deterministic baseline ripple so early cycles do not look ruled. */
const ripple = (c: number, seed: number) =>
  1 + 0.05 * Math.sin(c * 1.9 + seed * 2.3) + 0.03 * Math.sin(c * 0.73 + seed * 5.1) + 0.025 * Math.sin(c * 3.7 + seed);

type Curve = { mid: number; plateau: number; base: number; seed: number; hi?: boolean };
const series: Curve[] = [
  { mid: 19.0, plateau: 4.6, base: 0.0042, seed: 1 },
  { mid: 22.4, plateau: 4.2, base: 0.0036, seed: 2 },
  { mid: 25.7, plateau: 3.9, base: 0.0045, seed: 3, hi: true },
  { mid: 29.1, plateau: 3.4, base: 0.0039, seed: 4 },
  { mid: 32.3, plateau: 2.9, base: 0.0034, seed: 5 },
];

const value = (c: Curve, cycle: number) => c.base * ripple(cycle, c.seed) + c.plateau / (1 + Math.exp(-K * (cycle - c.mid)));
const pathFor = (fn: (cycle: number) => number) => {
  let d = '';
  for (let i = 0; i <= CYCLES * 4; i++) {
    const cyc = i / 4;
    d += `${i === 0 ? 'M' : 'L'}${r1(x(cyc))} ${r1(y(fn(cyc)))}`;
  }
  return d;
};

const curves = series.map((c) => {
  const ct = c.mid - Math.log(c.plateau / (THRESHOLD - c.base) - 1) / K;
  return { ...c, ct, d: pathFor((cyc) => value(c, cyc)) };
});
const ntc = pathFor((cyc) => 0.0031 * ripple(cyc, 9));
const hi = curves.find((c) => c.hi)!;

const decades = [-3, -2, -1, 0, 1];
const minor = decades.slice(0, -1).flatMap((dec) => [2, 3, 4, 5, 6, 7, 8, 9].map((m) => m * 10 ** dec));
const xTicks = [0, 5, 10, 15, 20, 25, 30, 35, 40];
const yLabel = (dec: number) => (dec < 0 ? (10 ** dec).toFixed(-dec) : String(10 ** dec));
const ty = y(THRESHOLD);
---

<div class:list={['qpcr-wrap', className]}>
<svg
  class="qpcr"
  viewBox={`0 0 ${W} ${H}`}
  width={W}
  height={H}
  aria-hidden="true"
  focusable="false"
  fill="none"
>
  <g class="grid-minor">
    {minor.map((v) => <line x1={M.l} x2={W - M.r} y1={r1(y(v))} y2={r1(y(v))} />)}
  </g>
  <g class="grid-major">
    {decades.map((dec) => <line x1={M.l} x2={W - M.r} y1={r1(y(10 ** dec))} y2={r1(y(10 ** dec))} />)}
    {xTicks.map((c) => <line x1={r1(x(c))} x2={r1(x(c))} y1={M.t} y2={H - M.b} />)}
  </g>
  <g class="axis">
    <path d={`M${M.l} ${M.t}V${H - M.b}H${W - M.r}`} />
    {xTicks.map((c) => <line x1={r1(x(c))} x2={r1(x(c))} y1={H - M.b} y2={H - M.b + 4} />)}
    {decades.map((dec) => <line x1={M.l - 4} x2={M.l} y1={r1(y(10 ** dec))} y2={r1(y(10 ** dec))} />)}
  </g>

  {
    labels && (
      <g class="labels">
        {xTicks
          .filter((c) => c % 10 === 0)
          .map((c) => (
            <text x={r1(x(c))} y={H - M.b + 17} text-anchor="middle">
              {c}
            </text>
          ))}
        {decades.map((dec) => (
          <text x={M.l - 8} y={r1(y(10 ** dec)) + 3.5} text-anchor="end">
            {yLabel(dec)}
          </text>
        ))}
        <text class="cap" x={W - M.r} y={H - 2} text-anchor="end">
          CYCLE
        </text>
        <text class="cap" x={M.l + 8} y={M.t + 14}>
          {'Δ'}Rn (LOG)
        </text>
      </g>
    )
  }

  <path class="ntc" d={ntc} pathLength="1" />
  <g class="curves">
    {curves.filter((c) => !c.hi).map((c, i) => <path d={c.d} pathLength="1" style={`--i:${i}`} />)}
  </g>

  <g class="threshold">
    <line x1={M.l} x2={W - M.r} y1={r1(ty)} y2={r1(ty)} />
    {labels && (
      <text class="cap" x={M.l + 8} y={r1(ty) - 7}>
        THRESHOLD
      </text>
    )}
  </g>

  <path class="curve-hi" d={hi.d} pathLength="1" />

  <g class="ct">
    {curves.filter((c) => !c.hi).map((c) => <circle class="ct-dot" cx={r1(x(c.ct))} cy={r1(ty)} r="2.25" />)}
    <line class="ct-drop" x1={r1(x(hi.ct))} x2={r1(x(hi.ct))} y1={r1(ty)} y2={H - M.b} />
    <circle class="ct-hi" cx={r1(x(hi.ct))} cy={r1(ty)} r="3.5" />
    {
      labels && (
        <text class="ct-label" x={r1(x(hi.ct)) + 9} y={H - M.b - 9}>
          Ct {hi.ct.toFixed(1)}
        </text>
      )
    }
  </g>
</svg>
</div>

<style>
  .qpcr-wrap {
    container-type: inline-size;
  }
  .qpcr {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* Hairlines stay 1px at any size. Curves scale with the plot (non-scaling strokes break the draw-in dash). */
  line,
  .axis path,
  circle {
    vector-effect: non-scaling-stroke;
  }
  .grid-minor line {
    stroke: var(--grid);
    stroke-width: 1;
  }
  .grid-major line {
    stroke: var(--grid-strong);
    stroke-width: 1;
  }
  .axis path,
  .axis line {
    stroke: var(--border-strong);
    stroke-width: 1;
  }
  text {
    font-family: var(--font-mono);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    fill: var(--faint);
  }
  .cap {
    font-size: 9px;
    letter-spacing: 0.1em;
  }
  .curves path {
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-linejoin: round;
    opacity: 0.75;
  }
  .ntc {
    stroke: var(--faint);
    stroke-width: 1;
    opacity: 0.7;
  }
  .curve-hi {
    stroke: var(--accent);
    stroke-width: 2.25;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .threshold line {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 5 4;
    opacity: 0.8;
  }
  .threshold text {
    fill: var(--accent-text);
  }
  .ct-dot {
    fill: var(--bg);
    stroke: var(--muted);
    stroke-width: 1;
  }
  .ct-drop {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .ct-hi {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .ct-label {
    font-size: 11px;
    font-weight: 600;
    fill: var(--accent-text);
  }

  /* Narrow renders: axis numbers would be unreadably small, so keep only the Ct readout, larger. */
  @container (max-width: 30rem) {
    .labels,
    .threshold text {
      display: none;
    }
    .ct-label {
      font-size: 19px;
    }
    .curves path {
      stroke-width: 2.25;
    }
    .curve-hi {
      stroke-width: 3.5;
    }
    .ntc {
      stroke-width: 1.5;
    }
  }

  /* One-time draw-in. Base styles are the finished state, so nothing depends on the animation running. */
  @media (prefers-reduced-motion: no-preference) {
    .curves path,
    .curve-hi,
    .ntc {
      animation: qpcr-draw 1400ms cubic-bezier(0.4, 0, 0.2, 1) backwards;
    }
    .curves path {
      animation-delay: calc(var(--i) * 110ms + 100ms);
    }
    .curve-hi {
      animation-delay: 350ms;
    }
    .threshold,
    .ct {
      animation: qpcr-fade 300ms ease-out backwards;
    }
    .threshold {
      animation-delay: 200ms;
    }
    .ct {
      animation-delay: 1700ms;
    }
  }
  @keyframes qpcr-draw {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }
  @keyframes qpcr-fade {
    from {
      opacity: 0;
    }
  }
</style>
