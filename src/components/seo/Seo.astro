---
/**
 * Head metadata: canonical URL, Open Graph, Twitter card, icons, JSON-LD.
 * Rendered inside <head> by layouts/Base.astro.
 */
import { profile } from '../../data/profile';

interface Props {
  /** Full <title> text. */
  title: string;
  description: string;
  /** Absolute or root-relative image path for social cards. */
  image?: string;
  type?: 'website' | 'article' | 'profile';
  /** One or more JSON-LD objects. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image, type = 'website', jsonLd, noindex = false } = Astro.props;

const site = Astro.site ?? new URL('https://semiquant.com');
const canonical = new URL(Astro.url.pathname, site).href;
const isDefaultImage = !image;
const imageUrl = new URL(image ?? '/og.png', site).href;
const imageAlt = isDefaultImage
  ? `${profile.name}: ${profile.focus.join(', ')}`
  : title;

const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
/** Escape characters that could close the script element. */
const serialize = (data: unknown) =>
  JSON.stringify(data)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026');

const meLinks = profile.links.filter((l) => l.me);
---

<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="author" content={profile.name} />
<meta name="theme-color" content="#0B0D10" />

<meta property="og:site_name" content={profile.brand} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{isDefaultImage && <meta property="og:image:type" content="image/png" />}
{isDefaultImage && <meta property="og:image:width" content="1200" />}
{isDefaultImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
{meLinks.map((l) => <link rel="me" href={l.url} />)}

{jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={serialize(item)} />)}
