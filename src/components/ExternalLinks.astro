---
/**
 * Row of labeled mono links for a project's `links` object
 * (repo, web, pypi, bioconda, paper, protocol, video, appstore).
 * Renders nothing when the object is empty.
 * Usage: <ExternalLinks links={project.data.links} />
 */
interface Props {
  links: Partial<Record<'repo' | 'web' | 'pypi' | 'bioconda' | 'paper' | 'protocol' | 'video' | 'appstore', string>>;
  /** Accessible name for the list. */
  label?: string;
  /** Project name, added as hidden text so each link has a distinct accessible name. */
  name?: string;
}

const { links, label = 'Links', name } = Astro.props;

const ORDER = [
  ['web', 'Web app'],
  ['repo', 'Repo'],
  ['pypi', 'PyPI'],
  ['bioconda', 'Bioconda'],
  ['paper', 'Paper'],
  ['protocol', 'Protocol'],
  ['video', 'Video'],
  ['appstore', 'App Store'],
] as const;

const items = ORDER.flatMap(([key, text]) => (links?.[key] ? [{ key, text, url: links[key] as string }] : []));
---

{
  items.length > 0 && (
    <ul class="ext-links" aria-label={label}>
      {items.map((l) => (
        <li>
          <a href={l.url} rel="noopener">
            {l.text}
            {name && <span class="visually-hidden">: {name}</span>}
            <span class="arrow" aria-hidden="true">
              <svg viewBox="0 0 10 10" width="9" height="9" focusable="false"><path d="M2.5 7.5l5-5M3.5 2.5h4v4" fill="none" stroke="currentColor" stroke-width="1.25"></path></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .ext-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    padding-block: 0.2rem;
    text-decoration: none;
    white-space: nowrap;
  }
  a:hover {
    text-decoration: underline;
  }
  .arrow {
    align-self: center;
    flex: none;
  }
</style>
