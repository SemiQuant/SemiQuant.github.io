{
  "name": "semiquant-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "guard": "node scripts/guard.mjs",
    "audit": "node scripts/audit-content.mjs",
    "cv:extract": "node scripts/extract-cv.mjs",
    "pubs:enrich": "node scripts/enrich-pubs.mjs",
    "pubs:add": "node scripts/add-pub.mjs",
    "cv:pdf": "bash scripts/cv-pdf.sh",
    "lint:copy": "node scripts/lint-copy.mjs",
    "links": "node scripts/check-links.mjs",
    "links:external": "node scripts/check-links.mjs --external",
    "icons": "node scripts/make-icons.mjs",
    "og": "node scripts/make-og.mjs",
