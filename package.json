    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "astro": "^7.4.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
